# HECTRON Live Universe — modo gratuito local
PORT=3000
APP_HOST=0.0.0.0
APP_NAME=HECTRON

# Agente y control PRISM (opcionales)
AGENT_TOKEN=your_agent_token_here
PRISM_WINDOW_TITLE=OBS Studio
PRISM_PYTHON=/usr/bin/python3
PRISM_LAUNCH_CMD=

# Base de datos (opcional en modo local)
DATABASE_URL=
WEBHOOK_SECRET=local_webhook_secret

# IA opcional; sin clave usa heurísticas locales
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY_2=

# Telemetría local
TELEMETRY_FILE=./local-agent/data/telemetry.json
TELEMETRY_ENABLED=true

# dev | overlay | agent
MODE=dev
